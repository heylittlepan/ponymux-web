---
import Icon from "blume/components/Icon.astro";

interface Props {
  strings?: Partial<{
    no: string;
    question: string;
    thanks: string;
    yes: string;
  }>;
}

const labels = {
  no: "No",
  question: "Was this page helpful?",
  thanks: "Thanks for your feedback!",
  yes: "Yes",
  ...Astro.props.strings,
};

const buttonClass =
  "inline-flex items-center gap-2 rounded-blume border border-border px-4 py-2 text-foreground text-sm transition-colors hover:border-foreground";
---

<section
  aria-label={labels.question}
  class="mx-auto mt-12 flex max-w-content items-center justify-between gap-4 border-border border-t pt-6"
  data-pony-page-feedback
>
  <p class="text-muted-foreground text-sm">{labels.question}</p>
  <div class="flex items-center gap-2" data-feedback-actions>
    <button class={buttonClass} data-feedback-value="yes" type="button">
      <Icon name="thumbs-up" size={16} />
      {labels.yes}
    </button>
    <button class={buttonClass} data-feedback-value="no" type="button">
      <Icon name="thumbs-down" size={16} />
      {labels.no}
    </button>
  </div>
  <p class="hidden text-muted-foreground text-sm" data-feedback-thanks>
    {labels.thanks}
  </p>
</section>

<script>
  import { track } from "blume/components/layout/analytics-client.ts";

  interface UmamiWindow extends Window {
    umami?: {
      track?: (event: string, properties?: Record<string, string>) => void;
    };
  }

  const root = document.querySelector("[data-pony-page-feedback]");
  if (root) {
    const actions = root.querySelector("[data-feedback-actions]");
    const thanks = root.querySelector("[data-feedback-thanks]");

    for (const button of root.querySelectorAll("[data-feedback-value]")) {
      button.addEventListener("click", () => {
        const properties = {
          helpful: button.getAttribute("data-feedback-value") ?? "",
          path: location.pathname,
          title: document.title,
        };

        track("feedback", properties);
        (window as UmamiWindow).umami?.track?.("feedback", properties);
        actions?.classList.add("hidden");
        thanks?.classList.remove("hidden");
      });
    }
  }
</script>
