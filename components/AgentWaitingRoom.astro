<style>
  .agent-waiting-room {
    --illustration-ink: color-mix(in srgb, var(--pony-fg) 78%, var(--pony-bg));
    --illustration-soft-ink: color-mix(in srgb, var(--pony-fg) 32%, transparent);
    --illustration-paper: color-mix(in srgb, var(--pony-fg) 2.5%, var(--pony-bg));
    --illustration-body: color-mix(in srgb, var(--pony-fg) 12%, var(--pony-bg));
    --illustration-screen: color-mix(in srgb, var(--pony-bg) 18%, #101115);
    margin: 2rem 0 2.75rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .room {
    fill: var(--illustration-paper);
    stroke: var(--pony-border);
    stroke-width: 2;
  }

  .floor-line,
  .clock circle,
  .clock path,
  .plant-stems,
  .bench-legs,
  .pony-neck {
    fill: none;
    stroke: var(--illustration-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wall-art > rect:first-child,
  .clock > circle:first-child {
    fill: var(--pony-bg);
    stroke: var(--illustration-ink);
    stroke-width: 3;
  }

  .wall-art > rect:nth-child(2) {
    fill: color-mix(in srgb, var(--pony-accent) 5%, var(--pony-bg));
    stroke: color-mix(in srgb, var(--pony-accent) 35%, var(--pony-bg));
    stroke-width: 2;
  }

  .wall-art circle,
  .wall-art path {
    fill: color-mix(in srgb, var(--pony-accent) 58%, var(--pony-bg));
  }

  .clock > circle:last-child { fill: var(--pony-accent); stroke: none; }

  .plant-leaf {
    fill: color-mix(in srgb, var(--pony-accent) 45%, var(--pony-bg));
    stroke: var(--illustration-ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .plant-pot,
  .desk-pot {
    fill: var(--pony-bg);
    stroke: var(--illustration-ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .desk-pot {
    fill: color-mix(in srgb, var(--pony-accent) 58%, var(--pony-bg));
  }

  .bench-back,
  .bench-seat {
    fill: color-mix(in srgb, var(--pony-accent) 13%, var(--pony-bg));
    stroke: var(--illustration-ink);
    stroke-width: 3;
  }

  .bench-seams {
    fill: none;
    stroke: var(--pony-border);
    stroke-width: 2;
  }

  .agent-frame {
    fill: var(--pony-bg);
    stroke: var(--illustration-ink);
    stroke-width: 3;
  }

  .agent-divider {
    fill: none;
    stroke: var(--pony-border);
    stroke-width: 2;
  }

  .agent-screen { fill: var(--illustration-screen); }
  .status.danger { fill: var(--pony-danger); }
  .status.warning { fill: var(--pony-warning); }
  .status.success { fill: var(--pony-success); }

  .terminal-prompt {
    fill: none;
    stroke: color-mix(in srgb, var(--pony-fg) 84%, #fff);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .limb,
  .thinking-arm,
  .thumb-arm,
  .thumb {
    fill: none;
    stroke: var(--illustration-ink);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .thinking-arm,
  .thumb-arm,
  .thumb { stroke-width: 4; }

  .hand { fill: var(--illustration-ink); }

  .handheld {
    fill: color-mix(in srgb, var(--pony-accent) 45%, var(--pony-bg));
    stroke: var(--illustration-ink);
    stroke-width: 2;
  }

  .handheld-dot { fill: var(--pony-accent); }
  .handheld-line { stroke: var(--illustration-ink); stroke-width: 2; stroke-linecap: round; }

  .laptop {
    fill: color-mix(in srgb, var(--pony-accent) 70%, var(--pony-bg));
    stroke: var(--illustration-ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .laptop-dot { fill: var(--pony-bg); }

  .bubble {
    fill: var(--pony-bg);
    stroke: var(--illustration-ink);
    stroke-width: 2.5;
  }

  .working circle { fill: var(--pony-accent); }

  .question-mark {
    fill: none;
    stroke: var(--pony-warning);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .check {
    fill: none;
    stroke: var(--pony-success);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pony-back-mane,
  .pony-top-mane {
    fill: color-mix(in srgb, var(--pony-accent) 42%, var(--pony-bg));
    stroke: var(--illustration-ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .pony-head,
  .pony-ear {
    fill: var(--illustration-body);
    stroke: var(--illustration-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pony-ear-inner {
    fill: none;
    stroke: color-mix(in srgb, var(--pony-magenta) 55%, var(--pony-bg));
    stroke-width: 3;
    stroke-linecap: round;
  }

  .pony-eye { fill: var(--illustration-ink); }
  .pony-eye-shine { fill: var(--illustration-paper); }
  .pony-nostril { fill: color-mix(in srgb, var(--pony-magenta) 55%, var(--pony-bg)); }
  .pony-blush { fill: color-mix(in srgb, var(--pony-magenta) 22%, var(--pony-bg)); }

  .pony-mouth {
    fill: none;
    stroke: var(--illustration-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .desk-front,
  .desk-top {
    fill: var(--pony-bg);
    stroke: var(--illustration-ink);
    stroke-width: 3;
  }

  .bell path,
  .bell circle {
    fill: color-mix(in srgb, var(--pony-accent) 42%, var(--pony-bg));
    stroke: var(--illustration-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .agent-three .terminal-prompt {
    animation: pony-agent-cursor 1.3s steps(2, end) infinite;
  }

  @keyframes pony-agent-cursor {
    50% { opacity: .42; }
  }

  @media (max-width: 640px) {
    .agent-waiting-room { margin-block: 1.75rem 2.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-three .terminal-prompt { animation: none; }
  }
</style>
