<figure class="not-prose agent-waiting-room">
  <svg
    viewBox="0 0 720 400"
    role="img"
    aria-labelledby="agent-waiting-room-title agent-waiting-room-description"
  >
    <title id="agent-waiting-room-title">A waiting room full of coding agents</title>
    <desc id="agent-waiting-room-description">
      Several terminal sessions wait quietly in different states while one session remains in focus.
    </desc>

    <defs>
      <linearGradient id="room-glow" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" class="glow-start"></stop>
        <stop offset="1" class="glow-end"></stop>
      </linearGradient>
      <filter id="soft-shadow" x="-30%" y="-30%" width="160%" height="170%">
        <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="var(--pony-shadow-ink)" flood-opacity=".14"></feDropShadow>
      </filter>
    </defs>

    <rect class="room" x="1" y="1" width="718" height="398" rx="26"></rect>
    <path class="ambient" d="M1 265C148 224 281 236 393 274c111 37 214 28 326-18v143H1Z"></path>
    <path class="floor-line" d="M1 296c151-35 279-20 391 13 115 34 222 22 327-22"></path>

    <g class="clock" aria-hidden="true">
      <circle cx="625" cy="73" r="29"></circle>
      <path d="M625 56v18l12 8"></path>
      <circle cx="625" cy="73" r="2.5"></circle>
    </g>

    <g class="plant" aria-hidden="true">
      <path d="M49 283c-1-28 4-51 16-70M65 247c-12-9-19-22-18-37M63 231c15-9 24-21 27-37M59 262c14-5 27-15 34-29"></path>
      <path class="plant-pot" d="M37 278h48l-7 53H45Z"></path>
    </g>

    <g class="bench" aria-hidden="true">
      <rect x="75" y="260" width="363" height="18" rx="9"></rect>
      <path d="M100 277v58M412 277v58"></path>
    </g>

    <g class="waiting-agent agent-one" transform="translate(82 157)">
      <rect class="agent-shell" width="102" height="82" rx="15"></rect>
      <path class="title-line" d="M1 22h100"></path>
      <circle class="status muted" cx="14" cy="12" r="4"></circle>
      <path class="prompt" d="m15 42 8 7-8 7M30 57h28M30 42h49"></path>
      <path class="feet" d="M29 82v19M73 82v19"></path>
      <g class="state-bubble working" transform="translate(69 -25)">
        <rect width="46" height="26" rx="13"></rect>
        <circle cx="15" cy="13" r="2.5"></circle>
        <circle cx="23" cy="13" r="2.5"></circle>
        <circle cx="31" cy="13" r="2.5"></circle>
      </g>
    </g>

    <g class="waiting-agent agent-two" transform="translate(205 148)">
      <rect class="agent-shell" width="102" height="90" rx="15"></rect>
      <path class="title-line" d="M1 22h100"></path>
      <circle class="status warning" cx="14" cy="12" r="4"></circle>
      <path class="prompt" d="M15 43h63M15 57h43M15 70h56"></path>
      <path class="feet" d="M29 90v20M73 90v20"></path>
      <g class="state-bubble question" transform="translate(68 -27)">
        <rect width="36" height="28" rx="14"></rect>
        <path d="M14 10c1-4 8-5 10-1 3 5-5 5-5 10M19 23h.1"></path>
      </g>
    </g>

    <g class="waiting-agent agent-three" transform="translate(329 160)">
      <rect class="agent-shell" width="102" height="79" rx="15"></rect>
      <path class="title-line" d="M1 22h100"></path>
      <circle class="status success" cx="14" cy="12" r="4"></circle>
      <path class="prompt" d="M15 43h54M15 57h36"></path>
      <path class="feet" d="M29 79v19M73 79v19"></path>
      <g class="state-bubble done" transform="translate(70 -25)">
        <rect width="38" height="27" rx="13.5"></rect>
        <path d="m12 14 6 5 10-12"></path>
      </g>
    </g>

    <g class="focus-session" transform="translate(468 151)" filter="url(#soft-shadow)">
      <rect class="focus-shell" width="211" height="169" rx="20"></rect>
      <path class="focus-title-line" d="M1 31h209"></path>
      <circle class="status accent" cx="17" cy="16" r="5"></circle>
      <circle class="status muted" cx="32" cy="16" r="5"></circle>
      <circle class="status muted" cx="47" cy="16" r="5"></circle>
      <path class="focus-prompt" d="m24 63 10 8-10 8M43 80h55M43 63h115M24 104h151M24 121h112"></path>
      <rect class="cursor" x="24" y="139" width="46" height="7" rx="3.5"></rect>
    </g>

    <g class="ticket" transform="translate(506 320) rotate(-3)" aria-hidden="true">
      <rect width="130" height="46" rx="12"></rect>
      <circle cx="21" cy="23" r="6"></circle>
      <path d="M38 18h68M38 28h49"></path>
    </g>
  </svg>
</figure>

<style>
  .agent-waiting-room {
    margin: 2rem 0 2.75rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .room {
    fill: url(#room-glow);
    stroke: var(--pony-border);
    stroke-width: 2;
  }

  .glow-start { stop-color: color-mix(in srgb, var(--pony-accent) 9%, var(--pony-bg)); }
  .glow-end { stop-color: color-mix(in srgb, var(--pony-fg) 3%, var(--pony-bg)); }

  .ambient {
    fill: color-mix(in srgb, var(--pony-accent) 5%, var(--pony-bg));
  }

  .floor-line,
  .clock circle,
  .clock path,
  .plant path,
  .bench path {
    fill: none;
    stroke: color-mix(in srgb, var(--pony-fg) 18%, transparent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .clock circle:last-child {
    fill: var(--pony-accent);
    stroke: none;
  }

  .plant-pot,
  .bench rect {
    fill: color-mix(in srgb, var(--pony-fg) 11%, var(--pony-bg));
    stroke: color-mix(in srgb, var(--pony-fg) 18%, transparent);
    stroke-width: 2;
  }

  .agent-shell {
    fill: var(--pony-bg);
    stroke: color-mix(in srgb, var(--pony-fg) 18%, transparent);
    stroke-width: 2;
  }

  .title-line {
    stroke: var(--pony-border);
    stroke-width: 2;
  }

  .prompt,
  .feet {
    fill: none;
    stroke: var(--pony-fg-icon);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feet {
    stroke-width: 3;
  }

  .status.muted { fill: var(--pony-fg-icon); }
  .status.warning { fill: var(--pony-warning); }
  .status.success { fill: var(--pony-success); }
  .status.accent { fill: var(--pony-accent); }

  .state-bubble rect {
    fill: color-mix(in srgb, var(--pony-fg) 7%, var(--pony-bg));
    stroke: var(--pony-border);
    stroke-width: 2;
  }

  .state-bubble path {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .working circle { fill: var(--pony-accent); }
  .question path { stroke: var(--pony-warning); }
  .done path { stroke: var(--pony-success); }

  .focus-shell {
    fill: color-mix(in srgb, var(--pony-accent) 8%, var(--pony-bg));
    stroke: var(--pony-accent);
    stroke-width: 3;
  }

  .focus-title-line {
    stroke: color-mix(in srgb, var(--pony-accent) 30%, transparent);
    stroke-width: 2;
  }

  .focus-prompt {
    fill: none;
    stroke: var(--pony-fg-secondary);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cursor {
    fill: var(--pony-accent);
    transform-origin: center;
    animation: pony-cursor 1.2s steps(2, end) infinite;
  }

  .ticket rect {
    fill: var(--pony-bg);
    stroke: var(--pony-border);
    stroke-width: 2;
  }

  .ticket circle { fill: var(--pony-magenta); }

  .ticket path {
    fill: none;
    stroke: var(--pony-fg-icon);
    stroke-width: 4;
    stroke-linecap: round;
  }

  @keyframes pony-cursor {
    50% { opacity: .28; }
  }

  @media (max-width: 640px) {
    .agent-waiting-room {
      margin-block: 1.75rem 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }
</style>
