---
const themes = [
  {
    id: "0x96f",
    name: "0x96f",
    mode: "dark",
    bg: "#262427",
    fg: "#fcfcfa",
    accent: "#00cde8",
    green: "#b3e03a",
  },
  {
    id: "tokyonight-night",
    name: "TokyoNight Night",
    mode: "dark",
    bg: "#1a1b26",
    fg: "#c0caf5",
    accent: "#7aa2f7",
    green: "#9ece6a",
  },
  {
    id: "catppuccin-frappe",
    name: "Catppuccin Frappe",
    mode: "dark",
    bg: "#303446",
    fg: "#c6d0f5",
    accent: "#8caaee",
    green: "#a6d189",
  },
  {
    id: "3024-day",
    name: "3024 Day",
    mode: "light",
    bg: "#f7f7f7",
    fg: "#4a4543",
    accent: "#01a0e4",
    green: "#01a252",
  },
  {
    id: "catppuccin-latte",
    name: "Catppuccin Latte",
    mode: "light",
    bg: "#eff1f5",
    fg: "#4c4f69",
    accent: "#1e66f5",
    green: "#40a02b",
  },
  {
    id: "tokyonight-day",
    name: "TokyoNight Day",
    mode: "light",
    bg: "#e1e2e7",
    fg: "#3760bf",
    accent: "#2e7de9",
    green: "#587539",
  },
];

const panelId = "pony-theme-panel";
---

<div class="theme-picker" data-pony-theme-picker>
  <button
    aria-controls={panelId}
    aria-expanded="false"
    aria-label="Change website theme"
    class="header-trigger"
    data-pony-theme-trigger
    type="button"
  >
    <span aria-hidden="true" class="theme-dots"><i></i><i></i><i></i></span>
  </button>

  <section aria-label="Choose a PonyMux theme" class="theme-panel" hidden id={panelId}>
    <header>
      <div><strong>Theme</strong><span>6 of 485 in PonyMux</span></div>
      <button aria-label="Close theme picker" data-pony-theme-close type="button">×</button>
    </header>
    <div class="theme-list">
      {themes.map((theme) => (
        <button
          aria-label={`Use ${theme.name} theme`}
          aria-pressed="false"
          class="theme-option"
          data-mode={theme.mode}
          data-name={theme.name}
          data-pony-theme-option={theme.id}
          style={`--preview-bg:${theme.bg};--preview-fg:${theme.fg};--preview-accent:${theme.accent};--preview-green:${theme.green}`}
          type="button"
        >
          <span aria-hidden="true" class="check">✓</span>
          <span class="theme-name">{theme.name}</span>
          <span aria-hidden="true" class="preview-dots"><i></i><i></i><i></i><i></i></span>
          <span class="theme-mode">{theme.mode}</span>
        </button>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (() => {
    const picker = document.querySelector("[data-pony-theme-picker]");
    if (!picker || picker.dataset.ready) return;
    picker.dataset.ready = "true";

    const root = document.documentElement;
    const panel = picker.querySelector(".theme-panel");
    const trigger = picker.querySelector("[data-pony-theme-trigger]");
    const options = [...picker.querySelectorAll("[data-pony-theme-option]")];
    const fallback = options.find((option) => option.dataset.ponyThemeOption === "tokyonight-night") || options[0];

    const readStored = () => {
      try { return localStorage.getItem("ponymux-theme"); } catch { return null; }
    };

    const remember = (id, mode) => {
      try {
        localStorage.setItem("ponymux-theme", id);
        localStorage.setItem("blume-theme", mode);
      } catch {}
    };

    const apply = (option, persist = true) => {
      if (!option) option = fallback;
      const id = option.dataset.ponyThemeOption;
      const name = option.dataset.name;
      const mode = option.dataset.mode;
      root.dataset.ponyTheme = id;
      root.dataset.theme = mode;
      root.style.colorScheme = mode;
      options.forEach((item) => item.setAttribute("aria-pressed", String(item === option)));
      document.querySelectorAll("[data-pony-current]").forEach((node) => { node.textContent = name; });
      let meta = document.querySelector('meta[name="theme-color"]');
      if (!meta) {
        meta = document.createElement("meta");
        meta.name = "theme-color";
        document.head.append(meta);
      }
      meta.content = getComputedStyle(root).getPropertyValue("--pony-bg").trim();
      if (persist) remember(id, mode);
      requestAnimationFrame(() => root.dataset.ponyReady = "true");
    };

    const setOpen = (open) => {
      panel.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
      picker.toggleAttribute("data-open", open);
      if (open) panel.querySelector('[aria-pressed="true"]')?.focus();
    };

    const stored = readStored();
    const selected = options.find((option) => option.dataset.ponyThemeOption === stored) || fallback;
    apply(selected, false);
    if (stored && stored !== selected.dataset.ponyThemeOption) {
      remember(selected.dataset.ponyThemeOption, selected.dataset.mode);
    }

    trigger.addEventListener("click", () => setOpen(panel.hidden));
    picker.querySelector("[data-pony-theme-close]").addEventListener("click", () => setOpen(false));
    options.forEach((option) => option.addEventListener("click", () => {
      apply(option);
      setOpen(false);
      trigger.focus();
    }));
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const opener = event.target.closest("[data-pony-open-theme]");
      if (opener) {
        event.preventDefault();
        setOpen(true);
        return;
      }
      if (!panel.hidden && !picker.contains(event.target)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });
  })();
</script>

<style>
  .theme-picker { position: fixed; top: 14px; inset-inline-end: max(18px, env(safe-area-inset-right)); z-index: 80; color: var(--pony-fg); font-family: var(--blume-font-body); }
  button { font: inherit; }

  .header-trigger {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--pony-fg-secondary);
    background: transparent;
    cursor: pointer;
  }
  .header-trigger:hover,
  .header-trigger:focus-visible { background: var(--pony-surface-hover); outline: none; }

  .theme-dots { width: 24px; display: inline-flex; align-items: center; justify-content: center; }
  .theme-dots i { width: 8px; height: 8px; margin-left: -2px; border: 1.5px solid var(--pony-bg); border-radius: 50%; }
  .theme-dots i:first-child { margin-left: 0; background: var(--pony-accent); }
  .theme-dots i:nth-child(2) { background: var(--pony-success); }
  .theme-dots i:nth-child(3) { background: var(--pony-warning); }

  .theme-panel {
    position: absolute;
    width: min(310px, calc(100vw - 28px));
    padding: 10px;
    border: 1px solid var(--pony-border);
    border-radius: 14px;
    color: var(--pony-fg);
    background: color-mix(in srgb, var(--pony-bg) 96%, transparent);
    box-shadow: var(--pony-shadow-lifted);
    backdrop-filter: blur(22px) saturate(1.2);
  }
  .theme-panel { top: calc(100% + 9px); right: 0; }
  .theme-panel[hidden] { display: none; }
  .theme-panel header { display: flex; justify-content: space-between; align-items: start; padding: 5px 6px 11px; }
  .theme-panel header strong, .theme-panel header span { display: block; }
  .theme-panel header strong { font-size: 13px; font-weight: 650; line-height: 1.2; }
  .theme-panel header span { margin-top: 3px; color: var(--pony-fg-tertiary); font: 9.5px/1.25 var(--blume-font-mono); }
  .theme-panel header button { width: 26px; height: 26px; border: 0; border-radius: 7px; color: var(--pony-fg-secondary); background: transparent; cursor: pointer; font-size: 18px; line-height: 1; }
  .theme-panel header button:hover { color: var(--pony-fg); background: var(--pony-surface-hover); }
  .theme-list { display: grid; gap: 3px; }

  .theme-option {
    min-width: 0;
    display: grid;
    grid-template-columns: 15px minmax(0, 1fr) auto 34px;
    gap: 9px;
    align-items: center;
    min-height: 38px;
    padding: 6px 8px;
    border: 0;
    border-radius: 8px;
    color: var(--pony-fg);
    background: transparent;
    text-align: left;
    cursor: pointer;
  }
  .theme-option:hover { background: var(--pony-surface-hover); }
  .theme-option[aria-pressed="true"] { background: var(--pony-surface-selected); }
  .theme-option:focus-visible { outline: 2px solid var(--pony-accent); outline-offset: -2px; }
  .check { color: transparent; font-size: 11px; }
  .theme-option[aria-pressed="true"] .check { color: var(--pony-accent); }
  .theme-name { overflow: hidden; color: var(--pony-fg); font-size: 11.5px; font-weight: 600; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
  .theme-mode { color: var(--pony-fg-tertiary); font: 9px/1 var(--blume-font-mono); text-transform: uppercase; }
  .preview-dots { display: flex; gap: 3px; }
  .preview-dots i { width: 7px; height: 7px; border-radius: 50%; box-shadow: 0 0 0 1px color-mix(in srgb, var(--preview-fg) 18%, transparent); }
  .preview-dots i:nth-child(1) { background: var(--preview-bg); }
  .preview-dots i:nth-child(2) { background: var(--preview-accent); }
  .preview-dots i:nth-child(3) { background: var(--preview-green); }
  .preview-dots i:nth-child(4) { background: var(--preview-fg); }

  @media (max-width: 520px) {
    .theme-picker { top: 14px; inset-inline-end: 12px; }
  }
</style>
