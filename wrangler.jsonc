{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ponymux-web",
  "account_id": "5c06968841ee115b80652dc2fef73d9c",
  "compatibility_date": "2026-08-13",
  "main": "./worker/index.js",
  "preview_urls": true,
  "r2_buckets": [
    {
      "binding": "UPDATES",
      "bucket_name": "ponymux-update"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/p/*", "/update/*", "/download", "/download/"]
  }
}
