---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import ThemePicker from "../components/ThemePicker.astro";
import PageFooter from "./_shared/PageFooter.astro";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={false}
  askEnabled={false}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "PonyMux — More agents. Less terminal chaos.",
    description: config.description,
    route: "/",
  }}
>
  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <div class="eyebrow"><span></span> Native for macOS</div>
        <h1>More agents.<br /><em>Less terminal chaos.</em></h1>
        <p class="lede">
          A terminal mux for the agent era — built around calm windows, durable
          sessions, and one strong opinion: you do not need more split panes.
        </p>
        <div class="actions">
          <a class="primary" href="#why">See the point of view</a>
          <a class="secondary" href="/blog">Follow the build <span>→</span></a>
        </div>
      </div>

      <div class="app-stage" aria-label="A conceptual preview of PonyMux">
        <div class="glow"></div>
        <div class="app-window">
          <div class="titlebar">
            <div class="lights"><i></i><i></i><i></i></div>
            <span>All Terminals</span>
            <span class="status">3 agents running</span>
          </div>
          <div class="app-body">
            <aside class="rail">
              <img src="/favicon.png" alt="" width="36" height="36" />
              <button class="rail-active">⌁</button>
              <button>◇</button>
              <button>⌕</button>
              <span></span>
              <button>⚙</button>
            </aside>
            <section class="sessions">
              <div class="session-head"><b>Sessions</b><button>＋</button></div>
              <div class="facet-row"><span class="active">All</span><span>Running</span><span>Waiting</span></div>
              <article class="session selected">
                <div class="agent-dot blue"></div>
                <div><b>Polish onboarding</b><small>Codex · 2m</small></div>
                <span class="pulse"></span>
              </article>
              <article class="session">
                <div class="agent-dot lilac"></div>
                <div><b>Refactor session store</b><small>Claude · 14m</small></div>
                <span class="badge">1</span>
              </article>
              <article class="session">
                <div class="agent-dot green"></div>
                <div><b>Research launch notes</b><small>Codex · waiting</small></div>
              </article>
              <p class="folder-label">LITTLE PAN / PONYMUX</p>
              <article class="session quiet">
                <div class="agent-dot amber"></div>
                <div><b>Website copy</b><small>Shell · yesterday</small></div>
              </article>
            </section>
            <section class="terminal">
              <header><span>Polish onboarding</span><div>⌁　⋯</div></header>
              <div class="terminal-copy">
                <p class="muted">~/Works/ponymux on main</p>
                <p><span class="prompt">›</span> Review the new session flow and simplify it.</p>
                <p class="agent-line">I found two places where the interface asks for a decision too early.</p>
                <p class="agent-line">I’m tightening the first-run path now.</p>
                <p class="success">✓ Updated onboarding flow</p>
                <p><span class="prompt">›</span><i class="cursor"></i></p>
              </div>
              <div class="memory"><span>✦</span><div><b>This terminal remembers</b><small>Project, agent and recent context stay together.</small></div></div>
            </section>
          </div>
        </div>
        <ThemePicker variant="inline" />
      </div>
    </section>

    <section class="manifesto shell" id="why">
      <p class="section-kicker">A different kind of mux</p>
      <h2>Split panes were made for terminals.<br />Agents changed the job.</h2>
      <p class="manifesto-copy">
        Once you are running five, ten, or twenty long-lived agents, squeezing
        them into smaller rectangles stops helping. PonyMux gives every session
        room to think — and gives you a better way to find, group, and recall it.
      </p>
      <div class="comparison">
        <div class="comparison-item old">
          <span>Traditional mux</span>
          <div class="split-grid"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <p>More panes. Less attention.</p>
        </div>
        <div class="arrow">→</div>
        <div class="comparison-item new">
          <span>PonyMux</span>
          <div class="focus-window"><i></i><b>One clear session</b><small>Everything else stays one shortcut away.</small></div>
          <p>More sessions. Less noise.</p>
        </div>
      </div>
    </section>

    <section class="principles shell">
      <article class="principle large">
        <span class="number">01</span>
        <div>
          <p class="section-kicker">Recall, not tab archaeology</p>
          <h3>Every terminal has a memory.</h3>
          <p>Sessions keep their project, agent, state, and history together. Lists and facets help you get back to the right thought without rebuilding context.</p>
        </div>
        <div class="memory-stack">
          <div><span>Today</span><b>Refactor session store</b><small>Claude · ponymux-macos</small></div>
          <div><span>Tuesday</span><b>Terminal safety model</b><small>Codex · research</small></div>
          <div><span>Last week</span><b>Why no split panes?</b><small>Shell · product notes</small></div>
        </div>
      </article>
      <article class="principle playful">
        <span class="number">02</span>
        <p class="section-kicker">Pursuit of happiness</p>
        <h3>Serious work does not have to feel cold.</h3>
        <p>Reactions, pets, themes, and shaders are not decoration added at the end. They are part of making a place you actually enjoy spending time in.</p>
        <button class="mood-button" data-pony-open-theme type="button">Change the mood <span>→</span></button>
        <div class="reactions"><span>✦</span><span>♥</span><span>☻</span><span>↯</span></div>
      </article>
      <article class="principle native">
        <span class="number">03</span>
        <p class="section-kicker">Light by default</p>
        <h3>Native Swift. Fast to open. Easy to keep open.</h3>
        <div class="native-list"><span>macOS native</span><span>Quick launch</span><span>Low overhead</span></div>
      </article>
    </section>

    <section class="closing shell">
      <img src="/images/ponymux-icon.png" alt="PonyMux app icon" width="132" height="132" />
      <div>
        <p class="section-kicker">Built in public, with a point of view</p>
        <h2>A calmer home for all the agents you run.</h2>
        <p>PonyMux is young, opinionated, and being shaped in the open. The <a href="/docs">docs</a> will grow with it.</p>
      </div>
      <a class="primary" href="/blog">Read the build notes</a>
    </section>
  </main>
  <PageFooter slot="footer" />
</PageLayout>

<style>
  :global(body) { overflow-x: hidden; }
  main { padding-bottom: 56px; }
  .shell { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  .hero { padding: 92px 0 76px; }
  .hero-copy { max-width: 850px; text-align: center; margin: 0 auto; }
  .eyebrow, .section-kicker { color: var(--blume-muted-foreground); font-size: 12px; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  .eyebrow { display: inline-flex; align-items: center; gap: 9px; padding: 7px 11px; border: 1px solid var(--blume-border); border-radius: 999px; background: color-mix(in srgb, var(--blume-background) 86%, transparent); }
  .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--pony-success); box-shadow: 0 0 0 4px color-mix(in srgb, var(--pony-success) 16%, transparent); }
  h1, h2, h3 { color: var(--blume-foreground); font-family: var(--blume-font-display); letter-spacing: -.055em; }
  h1 { margin: 28px 0 22px; font-size: clamp(52px, 8vw, 96px); line-height: .96; font-weight: 760; }
  h1 em { color: var(--blume-accent); font-style: normal; }
  .lede { max-width: 690px; margin: 0 auto; color: var(--blume-muted-foreground); font-size: clamp(18px, 2vw, 22px); line-height: 1.55; }
  .actions { display: flex; justify-content: center; gap: 14px; margin-top: 34px; }
  .primary, .secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 20px; border-radius: 13px; font-weight: 700; text-decoration: none; }
  .primary { color: var(--pony-accent-ink); background: var(--pony-accent); box-shadow: 0 10px 28px color-mix(in srgb, var(--pony-accent) 24%, transparent); }
  .primary:hover { background: color-mix(in srgb, var(--pony-accent) 88%, var(--pony-fg)); transform: translateY(-1px); }
  .secondary { color: var(--blume-foreground); border: 1px solid var(--blume-border); background: color-mix(in srgb, var(--blume-background) 75%, transparent); }
  .secondary span { margin-left: 9px; }
  .app-stage { position: relative; margin-top: 72px; }
  .glow { position: absolute; inset: -80px 10% auto; height: 360px; background: radial-gradient(ellipse, color-mix(in srgb, var(--pony-accent) 25%, transparent), transparent 68%); filter: blur(12px); pointer-events: none; }
  .app-window { position: relative; overflow: hidden; height: 620px; border: 1px solid var(--pony-border); border-radius: 22px; background: var(--pony-bg); box-shadow: var(--pony-shadow-lifted); color: var(--pony-fg); text-align: left; }
  .titlebar { height: 50px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 18px; background: var(--pony-surface); border-bottom: 1px solid var(--pony-border); color: var(--pony-fg-secondary); font-size: 12px; }
  .lights { display: flex; gap: 7px; }.lights i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }.lights i:nth-child(2){background:#febc2e}.lights i:nth-child(3){background:#28c840}
  .status { justify-self: end; color: var(--pony-fg-tertiary); }
  .app-body { display: grid; grid-template-columns: 64px 310px 1fr; height: calc(100% - 50px); }
  .rail { padding: 18px 12px; display: flex; flex-direction: column; align-items: center; gap: 10px; background: var(--pony-surface); border-right: 1px solid var(--pony-border); }
  .rail img { border-radius: 10px; margin-bottom: 8px; }.rail button { border: 0; width: 38px; height: 38px; border-radius: 10px; color: var(--pony-fg-icon); background: transparent; }.rail .rail-active { color: var(--pony-fg); background: var(--pony-surface-selected); }.rail span { flex: 1; }
  .sessions { background: color-mix(in srgb, var(--pony-fg) 3%, var(--pony-bg)); border-right: 1px solid var(--pony-border); padding: 16px 12px; }
  .session-head { display: flex; justify-content: space-between; align-items: center; padding: 2px 8px 14px; }.session-head button { border: 0; color: var(--pony-fg-icon); background: transparent; font-size: 18px; }
  .facet-row { display: flex; gap: 5px; margin: 0 5px 14px; }.facet-row span { padding: 5px 9px; border-radius: 7px; color: var(--pony-fg-tertiary); font-size: 10px; }.facet-row .active { color: var(--pony-fg); background: var(--pony-surface-selected); }
  .session { min-height: 68px; display: grid; grid-template-columns: 10px 1fr auto; gap: 10px; align-items: center; padding: 10px 11px; border-radius: 11px; margin-bottom: 6px; }.session.selected { background: var(--pony-surface-selected); box-shadow: inset 0 0 0 1px var(--pony-border); }.session b { display: block; font-size: 12px; font-weight: 620; }.session small { display: block; color: var(--pony-fg-tertiary); font-size: 10px; margin-top: 6px; }.session.quiet { opacity: .72; }
  .agent-dot { width: 8px; height: 8px; border-radius: 50%; }.blue{background:var(--pony-accent)}.lilac{background:var(--pony-magenta)}.green{background:var(--pony-success)}.amber{background:var(--pony-warning)}.pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--pony-accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--pony-accent) 14%, transparent); }.badge { min-width: 17px; height: 17px; padding: 0 5px; border-radius: 99px; display: grid; place-items: center; color: var(--pony-accent-ink); background: var(--pony-accent); font-size: 9px; }.folder-label { margin: 24px 10px 9px; color: var(--pony-fg-tertiary); font-size: 9px; letter-spacing: .1em; }
  .terminal { position: relative; min-width: 0; background: var(--pony-bg); font-family: var(--blume-font-mono); }.terminal header { height: 48px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid var(--pony-border); color: var(--pony-fg-secondary); font-family: var(--blume-font-body); font-size: 12px; }.terminal header div { color: var(--pony-fg-icon); }
  .terminal-copy { padding: 34px 32px; font-size: 13px; line-height: 1.8; }.terminal-copy p { margin: 0 0 10px; }.terminal-copy .muted { color: var(--pony-fg-tertiary); }.prompt { color: var(--pony-success); margin-right: 8px; }.agent-line { color: var(--pony-fg-secondary); padding-left: 18px; }.success { color: var(--pony-success); }.cursor { display: inline-block; width: 7px; height: 16px; background: var(--pony-fg); vertical-align: -3px; animation: blink 1s steps(1) infinite; }
  .memory { position: absolute; left: 28px; right: 28px; bottom: 28px; display: flex; gap: 12px; align-items: center; padding: 14px 16px; border: 1px solid color-mix(in srgb, var(--pony-accent) 22%, var(--pony-border)); border-radius: 12px; background: linear-gradient(135deg, color-mix(in srgb, var(--pony-accent) 10%, var(--pony-bg)), var(--pony-surface)); box-shadow: var(--pony-shadow-floating); font-family: var(--blume-font-body); }.memory > span { color: var(--pony-accent); }.memory b, .memory small { display: block; }.memory b { font-size: 11px; }.memory small { margin-top: 4px; color: var(--pony-fg-tertiary); font-size: 9px; }
  .manifesto { padding: 140px 0 120px; text-align: center; }
  h2 { margin: 18px 0 26px; font-size: clamp(40px, 6vw, 68px); line-height: 1.04; font-weight: 720; }
  .manifesto-copy { max-width: 720px; margin: auto; color: var(--blume-muted-foreground); font-size: 19px; line-height: 1.7; }
  .comparison { display: grid; grid-template-columns: 1fr 50px 1fr; align-items: center; margin-top: 64px; text-align: left; }.comparison-item { padding: 25px; border: 1px solid var(--blume-border); border-radius: 18px; background: color-mix(in srgb, var(--blume-muted) 74%, transparent); }.comparison-item > span { color: var(--blume-muted-foreground); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }.comparison-item > p { margin: 18px 0 0; font-weight: 700; }.arrow { color: var(--blume-muted-foreground); text-align: center; font-size: 24px; }
  .split-grid { height: 230px; display: grid; grid-template-columns: repeat(3,1fr); grid-template-rows: repeat(2,1fr); gap: 5px; margin-top: 18px; }.split-grid i { border-radius: 8px; background: repeating-linear-gradient(0deg,var(--pony-fg-tertiary) 0 2px,transparent 2px 12px), var(--pony-surface-selected); opacity: .75; }
  .focus-window { height: 230px; margin-top: 18px; padding: 30px; border-radius: 8px; display: flex; flex-direction: column; justify-content: center; background: var(--pony-bg); color: var(--pony-fg); }.focus-window i { width: 9px; height: 9px; border-radius: 50%; background: var(--pony-success); margin-bottom: 18px; }.focus-window b { font-size: 22px; }.focus-window small { color: var(--pony-fg-secondary); margin-top: 9px; }
  .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding-bottom: 120px; }.principle { position: relative; overflow: hidden; min-height: 470px; padding: 36px; border: 1px solid var(--blume-border); border-radius: 22px; background: var(--blume-muted); }.principle.large { grid-column: 1/-1; min-height: 500px; display: grid; grid-template-columns: .9fr 1.1fr; gap: 70px; align-items: center; }.number { position: absolute; top: 24px; right: 28px; color: var(--blume-muted-foreground); font: 11px var(--blume-font-mono); }.principle h3 { margin: 14px 0 18px; font-size: clamp(34px, 4vw, 50px); line-height: 1.05; }.principle > p, .principle > div > p { color: var(--blume-muted-foreground); line-height: 1.65; }
  .memory-stack { display: grid; gap: 10px; }.memory-stack div { padding: 20px; border: 1px solid var(--blume-border); border-radius: 13px; background: var(--blume-background); box-shadow: var(--pony-shadow-floating); }.memory-stack span,.memory-stack b,.memory-stack small{display:block}.memory-stack span{color:var(--blume-muted-foreground);font:10px var(--blume-font-mono);text-transform:uppercase}.memory-stack b{margin-top:8px}.memory-stack small{margin-top:5px;color:var(--blume-muted-foreground)}
  .playful { background: linear-gradient(145deg, color-mix(in srgb, var(--pony-accent) 16%, var(--blume-muted)), var(--blume-muted) 68%); }.reactions { position: absolute; left: 36px; right: 36px; bottom: 36px; display: flex; justify-content: space-between; }.reactions span { width: 62px; height: 62px; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--blume-border) 70%, var(--pony-accent)); border-radius: 18px; background: var(--blume-background); color: var(--blume-accent); font-size: 22px; transform: rotate(-5deg); }.reactions span:nth-child(even){transform:rotate(6deg) translateY(-12px)}
  .mood-button { margin-top: 22px; padding: 0; border: 0; color: var(--pony-accent); background: transparent; font-weight: 700; cursor: pointer; }.mood-button span { margin-left: 6px; }.mood-button:hover { text-decoration: underline; }
  .native-list { display: grid; gap: 10px; margin-top: 72px; }.native-list span { padding: 17px 18px; border-bottom: 1px solid var(--blume-border); font-weight: 650; }.native-list span::before { content: "✓"; color: var(--pony-success); margin-right: 11px; }
  .closing { display: grid; grid-template-columns: auto 1fr auto; gap: 32px; align-items: center; padding: 70px 36px; margin-bottom: 72px; border: 1px solid var(--blume-border); border-radius: 24px; background: var(--blume-muted); }.closing img { border-radius: 28px; box-shadow: 0 18px 40px color-mix(in srgb, var(--pony-accent) 22%, transparent); }.closing h2 { margin: 10px 0 8px; font-size: clamp(32px,4vw,48px); }.closing p { margin: 0; color: var(--blume-muted-foreground); }
  @keyframes blink { 50%{opacity:0} }
  @media (max-width: 900px) {
    .app-window { height: 560px; }.app-body{grid-template-columns:56px 240px 1fr}.terminal-copy{padding:26px 22px;font-size:11px}.memory{left:18px;right:18px}.principle.large{grid-template-columns:1fr;gap:32px}.closing{grid-template-columns:auto 1fr}.closing .primary{grid-column:1/-1}.comparison{grid-template-columns:1fr}.arrow{padding:14px;transform:rotate(90deg)}
  }
  @media (max-width: 700px) {
    .hero{padding-top:64px}.actions{flex-direction:column}.app-window{height:540px}.app-body{grid-template-columns:52px 1fr}.terminal{display:none}.principles{grid-template-columns:1fr}.principle.large{grid-column:auto}.comparison-item{padding:18px}.manifesto{padding:100px 0}.closing{grid-template-columns:1fr;text-align:center}.closing img{margin:auto}.closing .primary{grid-column:auto}.reactions span{width:50px;height:50px}.sessions{border-right:0}
  }
</style>
